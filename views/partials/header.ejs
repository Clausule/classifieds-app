<!DOCTYPE html>
<html lang="<%= locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% if (!isAdminPage) { %>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-XJ53LDVYF0"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-XJ53LDVYF0');
  </script>
  <!-- Ahrefs web analytics -->
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="E7KpoMVLEGU6zjw2zIUjLQ" async></script>
  <% } %>
  <%
    var pageTitle = typeof metaTitle !== 'undefined' ? metaTitle : (t(title) + ' — Listings');
    var pageDescription = typeof metaDescription !== 'undefined' ? metaDescription : null;
    var pageCanonical = typeof canonicalUrl !== 'undefined' ? canonicalUrl : null;
  %>
  <title><%= pageTitle %></title>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#0097be">
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex, follow"><% } %>
  <% if (pageDescription) { %><meta name="description" content="<%= pageDescription %>"><% } %>
  <% if (pageCanonical) { %>
    <link rel="canonical" href="<%= pageCanonical %>">
    <link rel="alternate" hreflang="nl" href="<%= siteUrl %><%= localePath %>">
    <link rel="alternate" hreflang="en" href="<%= siteUrl %>/en<%= localePath %>">
    <link rel="alternate" hreflang="x-default" href="<%= siteUrl %><%= localePath %>">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= pageCanonical %>">
    <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : defaultOgImage %>">
    <% if (pageDescription) { %><meta property="og:description" content="<%= pageDescription %>"><% } %>
  <% } %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Quickie.nu",
    "url": "<%= siteUrl %>",
    "description": "Quickie.nu is een Nederlands informatieplatform over sex advertenties en privé ontvangst."
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Quickie.nu",
    "url": "<%= siteUrl %>",
    "inLanguage": "<%= locale === 'en' ? 'en-US' : 'nl-NL' %>"
  }
  </script>
  <% if (typeof faqItems !== 'undefined') { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": <%- JSON.stringify(t('home.meta_title')) %>,
    "url": "<%= siteUrl %>/",
    "description": <%- JSON.stringify(t('home.meta_description')) %>,
    "isPartOf": { "@type": "WebSite", "name": "Quickie.nu", "url": "<%= siteUrl %>" },
    "mainEntity": {
      "@type": "ItemList",
      "name": "Overzicht van informatie",
      "itemListElement": [
        <% relatedLinks.forEach(function(link, i) { %>
        { "@type": "ListItem", "position": <%= i + 1 %>, "url": "<%= siteUrl %><%= link[0] %>", "name": <%- JSON.stringify(link[1]) %> }<%= i < relatedLinks.length - 1 ? ',' : '' %>
        <% }) %>
      ]
    },
    "inLanguage": "<%= locale === 'en' ? 'en-US' : 'nl-NL' %>"
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      <% faqItems.forEach(function(faq, i) { %>
      {
        "@type": "Question",
        "name": <%- JSON.stringify(faq[0]) %>,
        "acceptedAnswer": { "@type": "Answer", "text": <%- JSON.stringify(faq[1]) %> }
      }<%= i < faqItems.length - 1 ? ',' : '' %>
      <% }) %>
    ]
  }
  </script>
  <% } %>
  <% if (typeof listing !== 'undefined' && typeof canonicalUrl !== 'undefined') { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": <%- JSON.stringify(listing.doll_name) %>,
    "description": <%- JSON.stringify(listing.description || '') %>,
    <% if (listing.location) { %>"areaServed": { "@type": "City", "name": <%- JSON.stringify(listing.location) %> },<% } %>
    <% if (listing.price != null) { %>"offers": { "@type": "Offer", "price": "<%= listing.price %>", "priceCurrency": "EUR" },<% } %>
    <% if (images.length) { %>"image": <%- JSON.stringify(ogImage) %>,<% } %>
    "url": <%- JSON.stringify(canonicalUrl) %>
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": <%- JSON.stringify(t('listing_detail.breadcrumb_home')) %>, "item": "<%= siteUrl %><%= locale === 'en' ? '/en' : '' %>/" }
      <% if (cityUrl) { %>, { "@type": "ListItem", "position": 2, "name": <%- JSON.stringify(listing.location) %>, "item": <%- JSON.stringify(siteUrl + cityUrl) %> }<% } %>
      , { "@type": "ListItem", "position": <%= cityUrl ? 3 : 2 %>, "name": <%- JSON.stringify(listing.doll_name) %>, "item": <%- JSON.stringify(canonicalUrl) %> }
    ]
  }
  </script>
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <input type="checkbox" id="notice-sluit" class="notice-checkbox">
  <%# data-nosnippet: Google bouwde het zoekresultaat op merknaam uit deze
      melding op (inclusief het kruisje van de sluitknop) i.p.v. uit de meta
      description. Het attribuut houdt de tekst uit de snippet; zichtbaarheid
      en indexering veranderen er niet van. De sluitknop hoort binnen deze div
      te blijven, anders staat het kruisje er alsnog in. %>
  <div class="launch-notice" data-nosnippet>
    <p><strong><%= tFrontend('notice.launch_title') %></strong> <%= tFrontend('notice.launch_message') %></p>
    <label for="notice-sluit" class="notice-close" title="<%= tFrontend('notice.close_aria') %>">×</label>
  </div>
  <header class="site-header">
    <div class="container nav-row">
      <a href="<%= frontendLocale === 'en' ? '/en' : '/' %>" class="wordmark" aria-label="Quickie.nu">
        <%- include('logo-mark') %>
      </a>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <button type="button" class="nav-toggle" id="nav-toggle" aria-label="<%= tAccount('nav.menu_aria') %>" aria-expanded="false" aria-controls="nav-links">
          <span></span><span></span><span></span>
        </button>
      <% } %>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <nav class="nav-links" id="nav-links">
          <% // navPrefix bouwt de URL op (routing volgt altijd de /en-frontend-
             // prefix), maar de zichtbare labels hieronder gebruiken bewust
             // tAccount() — dit is de ingelogde-omgeving-nav, die hoort altijd
             // de volledige accounttaal te volgen, op élke pagina (ook frontend-
             // pagina's als je toevallig bent ingelogd), niet t() (dat verschilt
             // per route: frontend-nl/en op publieke pagina's). %>
          <% var navPrefix = frontendLocale === 'en' ? '/en' : ''; %>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin"><%= tAccount('nav.admin') %></a>
          <% } else { %>
            <a href="<%= navPrefix %>/dashboard"><%= tAccount('nav.my_listings') %></a>
            <a href="<%= navPrefix %>/account/credits"><%= tAccount('nav.credits') %></a>
            <a href="<%= navPrefix %>/account/verify"><%= tAccount('nav.my_data') %></a>
            <a href="<%= navPrefix %>/account/settings"><%= tAccount('nav.settings') %></a>
            <a href="<%= navPrefix %>/dashboard/messages"><%= tAccount('nav.support') %></a>
          <% } %>
          <form action="<%= navPrefix %>/logout" method="POST" style="display:inline">
            <button type="submit" class="btn btn-outline btn-sm"><%= tAccount('nav.logout') %></button>
          </form>
        <% if (currentUser.role !== 'admin' && !currentUser.hasListings) { %>
          <a href="<%= navPrefix %>/listings/new" class="btn btn-brand btn-sm"><%= tAccount('nav.new_listing') %></a>
        <% } %>
      </nav>
      <% } %>
    </div>
  </header>
  <script>
    (function () {
      var toggle = document.getElementById('nav-toggle');
      var nav = document.getElementById('nav-links');
      if (!toggle) return;
      toggle.addEventListener('click', function () {
        var open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      nav.addEventListener('click', function (e) {
        if (e.target.tagName === 'A') {
          nav.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    })();
  </script>
