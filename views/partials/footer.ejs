  <footer class="site-footer">
    <div class="container footer-top">
      <div class="footer-columns">
        <div class="footer-col">
          <p class="footer-col-title"><%= tFrontend('footer.group_about') %></p>
          <% legalPages.filter(function(p) { return p.footerGroup === 'Quickie.nu'; }).forEach(function(p) { %><a href="<%= frontendLocale === 'en' ? '/en' : '' %>/<%= p.slug %>"><%= tFrontend(p.navLabelKey) %></a><% }) %>
          <a href="<%= frontendLocale === 'en' ? '/en' : '' %>/over-quickie#bedrijfsgegevens"><%= tFrontend('footer.contact') %></a>
        </div>
        <div class="footer-col">
          <p class="footer-col-title"><%= tFrontend('footer.group_policy') %></p>
          <% legalPages.filter(function(p) { return p.footerGroup === 'Beleid'; }).forEach(function(p) { %><a href="<%= frontendLocale === 'en' ? '/en' : '' %>/<%= p.slug %>"><%= tFrontend(p.navLabelKey) %></a><% }) %>
        </div>
        <% if (!(typeof currentUser !== 'undefined' && currentUser)) { %>
        <div class="footer-col">
          <p class="footer-col-title"><%= tFrontend('footer.group_advertise') %></p>
          <a href="<%= frontendLocale === 'en' ? '/en' : '' %>/login" data-ga-cta="login"><%= tFrontend('footer.login') %></a>
          <a href="<%= frontendLocale === 'en' ? '/en' : '' %>/register" data-ga-cta="register"><%= tFrontend('footer.new_listing') %></a>
        </div>
        <% } %>
      </div>
      <div class="footer-mark" aria-hidden="true"><%- include('brand-mark') %></div>
    </div>
    <div class="footer-bottom">
      <div class="container footer-meta">
        <%= tFrontend('footer.copyright', { year: new Date().getFullYear() }) %>
        &middot;
        <a href="<%= frontendLocale === 'en' ? localePath : ('/en' + localePath) %>"><%= tFrontend('common.language_switch') %></a>
      </div>
    </div>
  </footer>
  <script>
    document.addEventListener('click', function (e) {
      var el = e.target.closest('[data-ga-cta]');
      if (el && typeof gtag === 'function') {
        gtag('event', 'footer_cta_click', { cta: el.dataset.gaCta });
      }
    });
  </script>
</body>
</html>
