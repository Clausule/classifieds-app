<div class="form-row" style="max-width:200px;margin-bottom:16px;">
  <select id="form_lang_select" aria-label="<%= tForm('account_settings.communication_language_label') %>" onchange="window.location.href = '?formlang=' + this.value">
    <option value="nl" <%= formLocale === 'nl' ? 'selected' : '' %>><%= t('account_settings.language_nl') %></option>
    <option value="en" <%= formLocale === 'en' ? 'selected' : '' %>><%= t('account_settings.language_en') %></option>
    <option value="es" <%= formLocale === 'es' ? 'selected' : '' %>><%= t('account_settings.language_es') %></option>
    <option value="pt" <%= formLocale === 'pt' ? 'selected' : '' %>><%= t('account_settings.language_pt') %></option>
    <option value="ru" <%= formLocale === 'ru' ? 'selected' : '' %>><%= t('account_settings.language_ru') %></option>
  </select>
  <input type="hidden" name="form_lang" value="<%= formLocale %>">
</div>
