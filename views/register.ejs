<%- include('partials/header') %>

<div class="container auth-shell">
  <h1><%= t('auth.register.title') %></h1>
  <form method="POST" class="card">
    <%- include('partials/auth-lang-switch') %>
    <% if (error) { %><div class="alert alert-error"><%= tForm(error) %></div><% } %>
    <div class="form-row">
      <label for="email"><%= tForm('auth.register.email_label') %></label>
      <input type="email" id="email" name="email" required value="<%= form.email || '' %>">
      <p class="form-hint"><%= tForm('auth.register.email_hint') %></p>
    </div>
    <div class="form-row">
      <label for="password"><%= tForm('auth.register.password_label') %></label>
      <input type="password" id="password" name="password" required minlength="8">
      <p class="form-hint"><%= tForm('auth.register.password_hint') %></p>
    </div>
    <button type="submit" class="btn btn-brand btn-block"><%= tForm('auth.register.submit') %></button>
  </form>
  <p style="margin-top:14px;font-size:14px;"><%= t('auth.register.has_account') %> <a href="/login"><%= t('auth.register.login_link') %></a></p>
</div>

<script>
  document.querySelector('.auth-shell form').addEventListener('submit', function () {
    if (typeof gtag === 'function') gtag('event', 'register_submit_click', { language: '<%= locale %>' });
  });
</script>

<%- include('partials/footer') %>
