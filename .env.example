# Kopieer dit bestand naar .env en pas de waarden aan
PORT=3000
SESSION_SECRET=verander-dit-naar-iets-lang-en-willekeurigs

# Echte productie-domein, gebruikt in canonical/Open Graph/JSON-LD/hreflang-URL's
# (altijd dit domein, ook lokaal — nooit de lokale hostname).
SITE_URL=https://quickie.nu

# Gebruikt door db/seed.js om het eerste admin-account aan te maken
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Premium listings betaalprovider.
# mock   = geen account nodig, simuleert Mollie's testmodus-statussen lokaal (standaard)
# mollie = echte Mollie Test of Live API key hieronder invullen
PAYMENT_PROVIDER=mock
MOLLIE_API_KEY=

# Reverse geocoding voor de "gebruik mijn locatie"-knop op het listing-formulier
GOOGLE_MAPS_API_KEY=

# SMS + WhatsApp Business (support-berichten, telefoonverificatie, premium-commando's).
# mock   = geen Twilio-account nodig, logt verzonden berichten naar de console; inkomende
#          WhatsApp-berichten test je via Admin -> Support inbox -> WhatsApp-simulator (standaard)
# twilio = echt Twilio-account, WhatsApp Business-nummer via Meta goedgekeurd
MESSAGING_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_SMS_NUMBER=

# E-mailverzending (verificatiemail, kruis-kanaal-melding bij mislukte sms-verificatie).
# mock  = geen account nodig, logt de e-mail naar de console (standaard)
# brevo = echt Brevo-account, API key hieronder
EMAIL_PROVIDER=mock
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# AI-omschrijving voor listings (Google Gemini). Prompt-template zelf is
# beheerbaar via Admin -> Instellingen, niet hier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Geuploade foto's (listings + id-documenten/selfies) comprimeren naar .webp
# via sharp. Uit tot de migratie naar een echte server, want tot die tijd is
# bestandsgrootte geen probleem en wordt alle testdata toch verwijderd.
IMAGE_CONVERT_WEBP=false

# Marktplaats staat live maar heeft nog niet genoeg echte content — zolang dit
# op false staat, zenden listing- en stadspagina's noindex,follow uit. Op true
# zetten zodra er echt operationeel wordt gegaan (zie CLAUDE.md voor de
# bijbehorende sitemap-listings.xml-stap die daar dan bij hoort).
MARKETPLACE_OPERATIONAL=false
